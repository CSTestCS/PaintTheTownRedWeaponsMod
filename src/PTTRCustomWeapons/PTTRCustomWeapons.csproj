<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PTTRCustomWeapons</AssemblyName>
    <RootNamespace>PTTRCustomWeapons</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>Major</RollForward>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <!-- interop types compare by Unity's overloaded ==, nullable analysis gets this wrong -->
    <NoWarn>CS8602;CS8600;CS8604;CS8603;CS8625;CS1701;CS1702;CS1705</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)../../build/mod/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by MelonLoader at runtime: compile against them, never copy them. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stand-ins for the assemblies MelonLoader generates from the game (see src/Stubs). -->
    <ProjectReference Include="../Stubs/Il2Cppmscorlib/Il2Cppmscorlib.csproj" Private="false" />
    <ProjectReference Include="../Stubs/UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" Private="false" />
    <ProjectReference Include="../Stubs/UnityEngine.PhysicsModule/UnityEngine.PhysicsModule.csproj" Private="false" />
    <ProjectReference Include="../Stubs/UnityEngine.ImageConversionModule/UnityEngine.ImageConversionModule.csproj" Private="false" />
    <ProjectReference Include="../Stubs/UnityEngine.IMGUIModule/UnityEngine.IMGUIModule.csproj" Private="false" />
  </ItemGroup>
</Project>

<Project>
  <!--
    Reference-only stand-ins for the assemblies MelonLoader generates from the game on first launch
    (MelonLoader/Il2CppAssemblies). They only contain the members this mod calls, with the same
    names and signatures, so the mod can be compiled without owning the game. They are never shipped:
    at runtime the real generated assemblies are used.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0660;CS0661;CS1701;CS1702;CS1705;CS0649;CS0169;CS8618</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RollForward>Major</RollForward>
    <OutputPath>$(MSBuildThisFileDirectory)../../build/stubs/$(MSBuildProjectName)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.0" />
  </ItemGroup>
</Project>
